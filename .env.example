# ==============================================================================
# LYFTR AI — Environment Configuration Example
# ==============================================================================

# LLM Gateway Configuration
# Comma-separated list of at least two provider API keys (evaluated in order: key_1, key_2, ...)
LLM_API_KEYS=your_first_provider_api_key,your_second_provider_api_key

# Model identifier compatible with configured keys (LiteLLM format)
# Examples: gemini/gemini-2.0-flash, gpt-4o, claude-3-5-sonnet-20241022
LLM_MODEL=gemini/gemini-2.0-flash

# SQLite Database Location
# Required format: sqlite:////data/app.db (for Docker) or sqlite:///./app.db (for local non-docker)
DATABASE_URL=sqlite:////data/app.db

# Permitted CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Failover Test Hook Switch (disabled by default in production; set to true for evaluation & testing)
ENABLE_FAILURE_SIMULATION=false

# Default Session System Prompt
DEFAULT_SYSTEM_PROMPT=You are a helpful AI assistant.

# Inference Timeout in seconds
LLM_TIMEOUT_SECONDS=60

# Backend Server Port
PORT=8000

# Frontend Build-time API Base URL
VITE_API_BASE_URL=http://localhost:8000
